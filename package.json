{
  "name": "todo-er",
  "version": "1.0.0",
  "description": "A simple todo demo for data-modela npm package",
  "main": "index.js",
  "type": "module",
  "jest": {
    "automack": false,
    "setupFiles": [
      "./setup/setupEnzyme.js"
    ]
  },
  "scripts": {
    "test": "NODE_ENV=test npm run test:server",
    "test:server": "NODE_ENV=test mocha src/test",
    "start:dev": "NODE_ENV=dev nodemon src/app.js",
    "start": "node src/app.js",
    "coverage": "nyc npm run test && nyc report --reporter=lcov",
    "create:table": "node src/model/tables.js"
  },
  "keywords": [
    "Node",
    "task-marker-be",
    "JavaScript",
    "dummydata"
  ],
  "author": "Tutu Godfrey",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "chai-http": "^4.3.0",
    "cors": "^2.8.5",
    "data-modela": "^1.0.1",
    "dotenv-safe": "^6.1.0",
    "express": "^4.16.4",
    "isomorphic-fetch": "^2.2.1",
    "jsonwebtoken": "^8.5.1",
    "multer": "^1.4.2",
    "prom-client": "^13.1.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "mocha": "^11.8.0",
    "nodemon": "^1.19.0",
    "nyc": "^14.1.1"
  }
}
